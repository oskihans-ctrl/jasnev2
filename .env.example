# Firebase Configuration (Required for client)
# Get these values from Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abc123def456"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Gemini API Key (Required for Gemini AI features)
# AI Studio injects this automatically, or get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# OpenRouter API (Alternative AI provider / models - SERVER ONLY, NEVER USE VITE_ PREFIX)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="qwen/qwen3.7-flash"
OPENROUTER_VISION_MODEL="qwen/qwen3.7-flash"
OPENROUTER_TEXT_MODEL="qwen/qwen3.7-flash"

# BFF security (optional — defaults shown)
# Project used to verify Firebase ID tokens; falls back to VITE_FIREBASE_PROJECT_ID.
# FIREBASE_PROJECT_ID="your-project-id"
# Extra allowed browser origins (comma-separated). Vercel deployment URLs are added automatically.
# ALLOWED_ORIGINS="https://jasne.app"
# AI limits: per minute (user / guest per IP) and per day (user / guest per IP).
# RATE_LIMIT_AI_MAX=20
# RATE_LIMIT_AI_GUEST_MAX=8
# RATE_LIMIT_AI_DAILY_MAX=300
# RATE_LIMIT_AI_GUEST_DAILY_MAX=40
# Dev tools (DevHub, ?dev=1) in a non-dev build, e.g. Vercel Preview. NEVER in production.
# VITE_ENABLE_DEV_TOOLS="true"

# App URL
APP_URL="http://localhost:5173"

# Node Environment
NODE_ENV="development"

